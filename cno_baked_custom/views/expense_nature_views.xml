<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_expense_nature_list" model="ir.ui.view">
            <field name="name">expense.nature.list</field>
            <field name="model">expense.nature</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_expense_nature_form" model="ir.ui.view">
            <field name="name">expense.nature.form</field>
            <field name="model">expense.nature</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <field name="name"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_expense_nature" model="ir.actions.act_window">
            <field name="name">Expense Nature</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">expense.nature</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Expense Nature...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_expense_nature"
                  name="Expense Nature"
                  parent="cno_baked_custom.menu_menu_configuration"
                  action="action_expense_nature"
                  sequence="3"/>

    </data>
</odoo>