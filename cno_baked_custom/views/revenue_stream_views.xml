<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_revenue_stream_list" model="ir.ui.view">
            <field name="name">revenue.stream.list</field>
            <field name="model">revenue.stream</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_revenue_stream_form" model="ir.ui.view">
            <field name="name">revenue.stream.form</field>
            <field name="model">revenue.stream</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <field name="name"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_revenue_stream" model="ir.actions.act_window">
            <field name="name">Revenue Stream</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">revenue.stream</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Revenue Stream...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_revenue_stream"
                  name="Revenue Stream"
                  parent="cno_baked_custom.menu_menu_configuration"
                  action="action_revenue_stream"
                  sequence="4"/>

    </data>
</odoo>
