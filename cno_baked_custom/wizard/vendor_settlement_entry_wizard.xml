<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="vendor_settlement_entry_wizard_form_view" model="ir.ui.view">
            <field name="name">vendor.settlement.entry.wizard.form</field>
            <field name="model">vendor.settlement.entry.wizard</field>
            <field name="arch" type="xml">
                <form string="">

                    <button string="Create" name="action_create" type="object" class="oe_highlight" data-hotkey="q" confirm="You want to create!"/>
                    <footer>
                        <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="vendor_settlement_entry_wizard_window_act" model="ir.actions.act_window">
            <field name="name">Vendor Settlement Entry</field>
            <field name="res_model">vendor.settlement.entry.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="vendor_settlement_entry_wizard_form_view"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_vendor_settlement_entry"
              name="Vendor Settlement Entry"
              action="vendor_settlement_entry_wizard_window_act"
              parent="account.account_transactions_menu"
              sequence="3"/>



    </data>

</odoo>